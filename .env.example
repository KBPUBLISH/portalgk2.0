# Copy to .env.local for local preview/dev (Vite bakes these at build time).
# Production default in source is https://backendgk2-0.onrender.com when unset.
#
# IMPORTANT: The kid app must use the SAME backend as this CMS when you place
# main-map icons. If the app uses Render production and the portal uses local
# Mongo, pad alignment edits will never appear in the app.
# Portal apiClient paths already include `/api/...`, so the base URL should be
# the host root (no trailing `/api`) unless your proxy expects otherwise.
VITE_API_BASE_URL=http://127.0.0.1:5001
VITE_API_URL=http://127.0.0.1:5001
